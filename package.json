{
  "name": "mongo-issue-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small issue tracker with an Express API and real MongoDB persistence.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "seed": "node --env-file-if-exists=.env --import tsx server/seed.ts",
    "indexes": "node --env-file-if-exists=.env --import tsx server/indexes.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongoose": "9.11.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
